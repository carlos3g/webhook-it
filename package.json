{
  "name": "webhook-it",
  "private": true,
  "version": "0.1.0",
  "description": "Stable public URLs for webhooks, forwarded to your localhost. Runs 100% locally.",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@webhook-it/cli' build",
    "dev": "bun run --filter '@webhook-it/cli' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "start": "bun run apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
