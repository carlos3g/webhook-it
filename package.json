{
  "name": "webhook-it",
  "private": true,
  "version": "0.1.0",
  "description": "Stable public URLs for webhooks, forwarded to your localhost. Runs 100% locally.",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '@carlos3g/webhook-it' build",
    "build:npm": "bun run --filter '@carlos3g/webhook-it' build:npm",
    "dev": "bun run --filter '@carlos3g/webhook-it' dev",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun run apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@carlos3g/eslint-config": "^0.2.0",
    "@types/bun": "latest",
    "eslint": "^9",
    "typescript": "^5.7.2"
  }
}
